{
  "expo": {
    "name": "Ramalho´s Sweets",
    "slug": "ramalhos-sweets-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo ramalho´s sweets.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo ramalho´s sweets.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFAF2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo ramalho´s sweets.png",
        "backgroundColor": "#FFFAF2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video"
    ]
  }
}